# ============================================================
# ORANGIA - Environment variable template
# Copy to .env and adapt to your own local setup.
# Never commit real passwords, tokens or secrets.
# ============================================================

# ------------------------------------------------------------
# Database - PostgreSQL (JDBC)
# DB_URL      Full JDBC URL (host:port/database) used by
#             DriverManager through DatabaseConfig.URL.
# DB_USER     Database user (DatabaseConfig.USER).
# DB_PASSWORD Local password only. The value below is a
#             placeholder, not a credential.
#
# Current implementation defaults to localhost:5432/postgres.
# Project documentation also mentions orangia (5432) and
# orangia_test (5433); confirm locally before changing DB_URL.
# ------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USER=postgres
DB_PASSWORD=your_local_password
